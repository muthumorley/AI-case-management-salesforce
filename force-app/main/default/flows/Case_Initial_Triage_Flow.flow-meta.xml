<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>Record-Triggered Before-Save Flow. Fires when a Case is created or Case_Intent__c is updated. Assigns Priority and Urgency__c deterministically based on Case_Intent__c. Vehicle Breakdown always escalates to Critical urgency. Also initialises AI_Assistance_Status__c to Pending so the Agent Assist LWC knows to run.</description>
    <label>Case Initial Triage Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- ═══════════════════════════════════════════════
         START: Record-Triggered (Before Save)
         Fires on CREATE or when Case_Intent__c changes
         ═══════════════════════════════════════════════ -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Case_Intent</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Case_Intent__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <!-- ═══════════════════════════════════════════════
         DECISION: Evaluate Case_Intent__c value
         Routes to appropriate priority assignment branch
         ═══════════════════════════════════════════════ -->
    <decisions>
        <description>Reads Case_Intent__c and routes to the matching priority assignment. Default handles General Enquiry and any unclassified cases.</description>
        <name>Check_Case_Intent</name>
        <label>Check Case Intent</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Set_Low_Priority</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>General Enquiry or Unclassified</defaultConnectorLabel>

        <!-- Rule 1: Vehicle Breakdown — highest urgency, safety-critical -->
        <rules>
            <name>Is_Vehicle_Breakdown</name>
            <label>Is Vehicle Breakdown</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vehicle Breakdown</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Critical_Priority</targetReference>
            </connector>
        </rules>

        <!-- Rule 2: Billing — medium urgency, financial concern -->
        <rules>
            <name>Is_Billing</name>
            <label>Is Billing</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Billing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Medium_Priority</targetReference>
            </connector>
        </rules>

        <!-- Rule 3: Cancellation — medium urgency, time-sensitive booking window -->
        <rules>
            <name>Is_Cancellation</name>
            <label>Is Cancellation</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Medium_Priority</targetReference>
            </connector>
        </rules>

        <!-- Rule 4: Booking Change — low urgency, routine amendment -->
        <rules>
            <name>Is_Booking_Change</name>
            <label>Is Booking Change</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Intent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Booking Change</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Low_Priority</targetReference>
            </connector>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════════════
         ASSIGNMENT: Vehicle Breakdown → Critical
         Priority = High (highest standard SF value)
         Urgency__c = Critical (our custom field)
         ═══════════════════════════════════════════════ -->
    <assignments>
        <description>Vehicle Breakdown is a safety-critical scenario. Priority is set to the highest Salesforce standard value (High). Our custom Urgency__c is set to Critical to distinguish it from a high-priority non-emergency. AI_Assistance_Status__c is initialised to Pending so the LWC knows AI triage is needed.</description>
        <name>Set_Critical_Priority</name>
        <label>Set Critical Priority (Vehicle Breakdown)</label>
        <locationX>0</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Urgency__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AI_Assistance_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <!-- ═══════════════════════════════════════════════
         ASSIGNMENT: Billing / Cancellation → Medium
         ═══════════════════════════════════════════════ -->
    <assignments>
        <description>Billing and Cancellation cases need prompt attention but are not safety-critical. Medium priority ensures they are processed within standard SLA without jumping the queue ahead of emergencies.</description>
        <name>Set_Medium_Priority</name>
        <label>Set Medium Priority (Billing / Cancellation)</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Urgency__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AI_Assistance_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <!-- ═══════════════════════════════════════════════
         ASSIGNMENT: Booking Change / General → Low
         ═══════════════════════════════════════════════ -->
    <assignments>
        <description>Booking Changes and General Enquiries are routine. Low priority allows genuinely urgent cases to surface first in the agent queue.</description>
        <name>Set_Low_Priority</name>
        <label>Set Low Priority (Booking Change / General Enquiry)</label>
        <locationX>352</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Urgency__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AI_Assistance_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
    </assignments>

</Flow>
